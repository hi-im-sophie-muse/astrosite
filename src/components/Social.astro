---
const { platform, username } = Astro.props;
---
<a href={`https://www.${platform}.com/${username}`}>{platform}</a>
<style>
  a {
    padding: 0.5rem 1rem;
    color: black;
    background-color: #C0C0C0;
    text-decoration: none;
    font-family: "serif";
  }
    a:visited {
    color: #0E3800;
    }
    a:link {
    color:navy;
    }

</style>