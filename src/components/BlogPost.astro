---
const { title, url } = Astro.props
const { frontmatter } = Astro.props;
---
<li><a href={url}>{title}</a></li>
  <div class="tags">
    {frontmatter.tags.map((tag: string) => (
      <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
    ))}
  </div>


