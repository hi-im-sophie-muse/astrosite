---
import { getCollection, render } from 'astro:content';

import Desktop from '../components/Desktop.tsx';
import ThemeToggle from '../components/ThemeToggle.tsx';
import { Image } from 'astro:assets';
import DeskLayout from '../layouts/DeskLayout.astro';

const works = await getCollection('works', ({ data }) => !data.draft);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sophie Lacson-Lambinet',
  jobTitle: 'Composer',
  url: Astro.site?.href,
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
  try {
    const saved = localStorage.getItem('desktop-theme');
    if (saved) document.documentElement.dataset.theme = saved;
  } catch {}
</script>
  </head>
  <body>
    <DeskLayout title="landing • hi, i'm Sophie Lacson-Lambinet" description="Composer who specializes in orchestral video game music, but can do tons more! Sophie Lacson-Lambinet shares her Windows 95 desktop for visitors to peruse">   
    <ThemeToggle client:load />
    <main>
      <h2><a href="./sandbox" target="_blank">ORIGINAL ASTRO v0.4 HOMEPAGE</a><br/></h2>
      <Desktop client:load>
      <nav class="icons" aria-label="shortcuts">
        {works.map((entry) => (
        <a class="icon" href={'#' + entry.id} >
          {entry.data.coverArt && <Image src={entry.data.coverArt} alt="" width={64} />}
          <span>{entry.data.title}</span>
          </a>
        ))}
      </nav>
      {works.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <section class="window" id={entry.id}>
            <header class="titlebar" tabindex="0"><a href={'/works/' + entry.id} target="_blank">{entry.data.title}</a><button class="minbtn">_</button><button class="maxbtn" type="button" aria-label="maximize">□</button>
<button class="closebtn" type="button" aria-label="close">×</button></header>
            <div class="body">
              <img src={entry.data.kind} alt={entry.data.title} />
            <p>{entry.data.kind} · {entry.data.year}</p>
             <ol>
              {entry.data.tracks.map((t) => (
                <li>
                  <strong>{t.title}</strong> ({t.duration}) - {t.description}
                </li>
                <audio controls preload="none" src={`/audio/${entry.id}.wav`} />
              ))}
            </ol>
            <Content />
            </div>
          </section>
        );
      })}
        </Desktop>
      </main>
    </DeskLayout>
  </body>
</html>