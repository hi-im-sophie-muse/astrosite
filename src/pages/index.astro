---
import { getCollection, render } from 'astro:content';
import '../styles/theme.css';
import Desktop from '../components/Desktop.tsx';
import ThemeToggle from '../components/ThemeToggle.tsx';
import '@fontsource/win95fa';


const works = await getCollection('works', ({ data }) => !data.draft);
/// const { entry } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
  try {
    const saved = localStorage.getItem('desktop-theme');
    if (saved) document.documentElement.dataset.theme = saved;
  } catch {}
</script>
    <title>Landing</title>
   <!-- <meta name="description" content={entry.data.summary.trim()} /> -->
    <!--<script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MusicAlbum',
        name: entry.data.title,
        datePublished: String(entry.data.year),
        byArtist: { '@type': 'Person', name: 'Sophie Lacson-Lambinet', jobTitle: 'Composer' },
      })}
    />-->
  </head>
  <body>
    <ThemeToggle client:load />
    <main>
      <h2><a href="./sandbox" target="_blank">ORIGINAL ASTRO v0.4 HOMEPAGE</a><br/></h2>
      <Desktop client:load>
      <nav class="icons" aria-label="shortcuts">
        {works.map((entry) => (
        <a class="icon" href={'#' + entry.id} >
          <img src ={'/icons/' + entry.id + '.png'} alt="" width="32" height="32" />
          <span>{entry.data.title}</span>
          </a>
        ))}
      </nav>
      {works.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <section class="window" id={entry.id}> <!-- test -->
            <header class="titlebar" tabindex="0"><a href={'/works/' + entry.id}>{entry.data.title}</a><button class="minbtn">_</button></header>
            <div class="body">
              <img src={entry.data.kind} alt={entry.data.title} />
            <p>{entry.data.kind} · {entry.data.year}</p>
            <ol>
              {entry.data.tracks.map((t) => (
                <li>
                  <strong>{t.title}</strong> ({t.duration}) - {t.description}
                </li>
                <audio controls preload="none" src={`/audio/${entry.id}.wav`} />
              ))}
            </ol>
            <Content />
            </div>
          </section>
        );
      })}
        </Desktop>
      </main>
  </body>
</html>