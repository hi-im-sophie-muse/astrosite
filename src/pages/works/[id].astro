---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import DeskLayout from '../../layouts/DeskLayout.astro';
import { schemaTypeFor } from '../../lib/kinds';



export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const type = schemaTypeFor[entry.data.kind] ?? 'CreativeWork';
const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  name: entry.data.title,
  datePublished: String(entry.data.year),
  byArtist: { '@type': 'Person', name: 'Sophie Lacson-Lambinet', jobTitle: 'Composer' },
};

---
<DeskLayout title={entry.data.title} description={entry.data.summary.trim()} image={entry.data.coverArt?.src} imageAlt={"Cover Art for" + entry.data.title} schema={schema}>
<main class="sheet">
  <h1>{entry.data.title}</h1>
  <p>{entry.data.kind} · {entry.data.year}</p>
   {entry.data.links.length > 0 && (
    <ul>
      {entry.data.links.map((link) => (
        <li><a href={link.url} target="_blank">{link.label}</a></li>
      ))}
    </ul>
  )}
          {entry.data.coverArt && (
  <Image src={entry.data.coverArt} alt={'Cover art for ' + entry.data.title} width={480} />
  )}
  <h2>tracks</h2>
  <ol>
    {entry.data.tracks.map((t) => (
      <li>
        <strong>{t.title}</strong> ({t.duration}) — {t.description}
      </li>
    ))}
  </ol>
  {entry.data.instrumentation.length > 0 && (
        <p>for {entry.data.instrumentation.join(', ')}</p>
      )}
  <Content />
  <h2>Credits:</h2>
  <ul class="credits">
    <li>{entry.data.role}: Sophie Lacson-Lambinet</li>
    {entry.data.client && <li>For {entry.data.client}</li>}
    {entry.data.collaborators.map((c) => (
      <li>
        {c.role && c.role + ': '}
        {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : c.name}
      </li>
    ))}
  <li>License: {entry.data.license ?? 'CC BY-NC-SA 4.0'}</li>
  </ul>
  <p><a href="/">back</a></p>
</main>
</DeskLayout>