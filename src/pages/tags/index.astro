---
import BaseLayout from '../../layouts/BaseLayout.astro';
const allPosts = await getCollection("blog");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
import { getCollection } from "astro:content";
---
<!--const { pageTitle } = Astro.props;
  --- code would've ended here ---
<TestLayout pageTitle = {pageTitle} 
not every webpage is a greeting sandbox,
not every sandbox is virulent (thank god)
therefore, i must sadly comment you out, tutorial tag-->
<title>Ahoy there, ahoy!</title>
<BaseLayout>
  <div class="tags">
    {tags.map((tag) => (
      <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
    ))}
  </div>
  <h2>Castaways! We are castaways!</h2>
</BaseLayout>
<style>
  h2 {
    color: #ffeea4;
  }
  div {
    color: goldenrod;
  }
  a {
    color: maroon;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #c0c0c0;
  }
</style>