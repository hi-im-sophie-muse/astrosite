---
// Welcome to Astro! Everything between these triple-dash code fences
// is your "component frontmatter". It never runs in the browser.
console.log('This runs in your terminal, not the browser!');
import '../styles/global.css';
const pageTitle = "A VIRULENT SANDBOX??";
import Header from '../components/Header.astro'; 
const identity = {
  firstName: "sophie",
  country: "United States",
  occupation: "Composer",
  hobbies: ["isopod keeping", "gaming", "drawing"],
};

const skills = ["piano", "crying", "singing", "ukulele playing", "sorting", "yapping", "copy/pasting"];
const happy = true;
const finished = true;
const goal = 42;
const skillColor = "pink";
const fontWeight = "italic";
const textCase = "mixedcase";
---
<!-- Below is your "component template." It's just HTML, but with
    some magic sprinkled in to help you build great templates. -->

    
<html>
    <title>{pageTitle}</title>
    <head>    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    </head>
  <body>
        <p>look there's a head now-- WHY IS EVERYTHING SO CENTERED</p>
    <Header />
    <h1>How to make cool drop ! ! (2026) (works every time)</h1>
    <h1>boots and cats and [x4]</h1>
    <h2>boots-ee-and-a and-ee-and-a cats-ee-and-a and-ee-and-a [x4]</h2>
    <h3>BOO-OOTS AND CA-ATS-AH BOO-OOTS AND CA-ATS-AH</h3>
    <h1>done hope this helps</h1>
    <h3>see the boots and cats in action, clicky here: <a href="./portfolio" target="_blank">a href="./portfolio" target="_blank"</a></h3>
    <br/><br/>
    <p>day 2 of editing this page<br/>oh...and because i'm still in tutorial mode:<br/><br/>copy paste begins here:
    <br/>{pageTitle}
      <p>Here are a few facts about me:</p>
  <ul>
    <li>My name is {identity.firstName}.</li>
    <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
    {identity.hobbies.length >= 2 &&
      <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
    }
  </ul>
  <p>My skills are:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>
  <p>(copy paste ends here)<br/>
  janky but it gets the point across. love from "sophie" who lives "in United States" (utc-8)
      <br/> oh i thought i was done with that page, i guess i'm not<br/></p>
    {happy && <p>I am happy to be learning Astro! They made me write this one down!</p>}

  {finished && <p>I finished this tutorial! If you're seeing this, I'm either actually done (YES) or I funked something up! (YES BUT THE PRIOR IS STILL TRUE)</p>}

  {goal === 42 ? <p>My goal is to finish in 42 days.</p> : <p>My goal is not 42 days.</p>}</p><br/>
  <script>
  import "../scripts/menu.js";
  </script>
    </body>
    <footer><a href="/" target="_blank">I love target=_blank and having 20 tabs open. Do you? (back to home) 
      <br/><br/>I had to style this to make the joke still work. (a:link = blue / a:visited = purple)

      <br/>Click this link to support the Lakers. Use the back button and don't click the link to keep supporting the Golden State Warriors. Winners always click the link.</a></footer>
</html>
<style define:vars={{skillColor, fontWeight, textCase}}>
  p {
    color: #fff;
    font-family: "Comic Sans MS", cursive, sans-serif;
  }
  ul {
    color: #a6ffb2;
    font-family: "Comic Sans MS", cursive, sans-serif;
  }
  h1 {
    color: #fff;
    font-size: 2.25rem;
  }
  h2 {
    color: #ff0000;
  }
  h3 {
    color: #839de2;
  }
  body {
    background-color: #000000;
  }

  footer {
    background-color: #fceb58;
    
    a:link {
    color: blue;
    }
  a:visited {
  color: purple
 
  }}

  .skill {
    color: var(--skillColor);
    font-style: var(--fontWeight);
    text-transform: var(--textCase);
  }
</style>