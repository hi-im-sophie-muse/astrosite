---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import BlogPost from '../components/BlogPost.astro';
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
---

<html lang="en">
  <head>
    <title>Sandfolio</title>
     <meta charset="utf-8" />
  </head>
  <body>
    <header>
      <p>
        this time, no target=_blank (new tab)<br />
        because im too lazy to remove them upon deployment
      </p>
      <a href="/">entrance</a><br />
      <a href="/about/">boots</a><br />
      <a href="/portfolio/">portfolio</a><br />
    </header>

    <main>
      <h1>
        tutorial said make a blog, but this will be a portfolio;<br />
        let's save myself from pressing ctrl-f blog backspace portfolio ctrl-c ctrl-f blog backspace ctrl-v
      </h1>

      <ul>
        {allPosts.map((post: any) => (
          <BlogPost url={`/posts/${post.id}/`} title={post.data.title} />
        ))}
      </ul>
    </main>

    <footer>
      <Navigation />
    </footer>
  </body>
</html>

<style>
  h1 {
    color: #fff;
  }

  header {
    background-color: <!--#bebebe-->#000000;
  }

  body {
    background-color: #000000;
  }
  p {
    color: #bebebe;
  }
</style>
