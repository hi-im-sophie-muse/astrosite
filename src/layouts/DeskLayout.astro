---
import SiteHead from '../components/SiteHead.astro';
import '../styles/theme.css';
import '@fontsource/win95fa';

const { title, description, image, schema } = Astro.props;
---

<html lang="en">
<head>
    <SiteHead title={title} description={description} image={image} schema={schema} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 <script is:inline>
  try {
    for (const name of ['theme', 'sound', 'motion']) {
    const saved = localStorage.getItem('desktop-' + name);
    if (saved) document.documentElement.dataset[name] = saved;
    }
    } catch {}
  </script>
</head>
<body>
    <slot />
</body>
</html>